generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

model Establishment {
  id                     String         @id @default(uuid())
  slug                   String         @unique
  name                   String
  niche                  String
  created_at             DateTime       @default(now())
  updated_at             DateTime       @updatedAt
  status                 String         @default("TRIAL")
  trial_ends_at          DateTime?
  initial_password       String?
  pause_start            DateTime?
  paused_until           DateTime?
  whatsapp_api_url       String?
  whatsapp_instance_name String?
  whatsapp_api_key       String?
  whatsapp_enabled       Boolean        @default(false)
  appointments           Appointment[]
  attendants             Attendant[]
  businessHours          BusinessHour[]
  clients                Client[]
  services               Service[]
  users                  User[]
}

model BusinessHour {
  id               String        @id @default(uuid())
  establishment_id String
  day_of_week      Int
  open_time        String        @default("08:00")
  close_time       String        @default("18:00")
  is_closed        Boolean       @default(false)
  establishment    Establishment @relation(fields: [establishment_id], references: [id], onDelete: Cascade)

  @@unique([establishment_id, day_of_week])
}

model User {
  id               String         @id
  email            String         @unique
  name             String
  role             String         @default("USER")
  establishment_id String?
  establishment    Establishment? @relation(fields: [establishment_id], references: [id], onDelete: Cascade)
}

model Attendant {
  id            String             @id @default(uuid())
  tenant_id     String
  name          String
  email         String?
  phone         String?
  pause_start          DateTime?
  paused_until         DateTime?
  google_access_token  String?
  google_refresh_token String?
  created_at    DateTime           @default(now())
  appointments  Appointment[]
  establishment Establishment      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  services      AttendantService[]
}

model Service {
  id               String             @id @default(uuid())
  tenant_id        String
  name             String
  description      String?
  duration_minutes Int
  price            Float
  hide_price       Boolean            @default(false)
  created_at       DateTime           @default(now())
  appointments     Appointment[]
  attendants       AttendantService[]
  establishment    Establishment      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model AttendantService {
  attendant_id String
  service_id   String
  attendant    Attendant @relation(fields: [attendant_id], references: [id], onDelete: Cascade)
  service      Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@id([attendant_id, service_id])
}

model Appointment {
  id             String        @id @default(uuid())
  tenant_id      String
  client_name    String
  client_phone   String
  client_email   String?
  service_id     String
  attendant_id   String
  client_id      String?
  date_time      DateTime
  status         String        @default("SCHEDULED")
  created_at      DateTime      @default(now())
  reminder_sent   Boolean       @default(false)
  google_event_id String?
  attendant      Attendant     @relation(fields: [attendant_id], references: [id], onDelete: Cascade)
  client_profile Client?       @relation(fields: [client_id], references: [id])
  service        Service       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  establishment  Establishment @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, date_time])
  @@index([attendant_id, date_time])
  @@index([tenant_id, attendant_id, status])
}

model Client {
  id            String        @id @default(uuid())
  tenant_id     String
  name          String
  phone         String
  email         String?
  notes         String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  appointments  Appointment[]
  establishment Establishment @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, phone])
  @@index([tenant_id, name])
}
